# Copy to .env.local for local development. These two values are PUBLIC by
# design (they ship in the browser bundle); row-level security protects the data.
# In production they come from GitHub Actions secrets instead — see docs/SETUP.md.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
