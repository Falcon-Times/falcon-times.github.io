{
  "name": "falcon-times",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "The Falcon Times — Avon High School student newspaper",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "seed:sql": "node scripts/generate-seed-sql.mjs",
    "seed:check": "node scripts/generate-seed-sql.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "lucide-preact": "^1.59.0",
    "marked": "^18.1.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
